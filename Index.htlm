<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VenePetrol Intel B2B & Business Directory</title>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    :root {
      --bg: #0b0f17;
      --panel: #131a26;
      --panel-2: #1a2333;
      --border: #263248;
      --accent: #f59e0b;
      --accent-2: #38bdf8;
      --text: #f1f5f9;
      --muted: #94a3b8;
      --success: #10b981;
      --danger: #ef4444;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background: var(--bg); color: var(--text); display: flex; flex-direction: column; min-height: 100vh; }
    header {
      background: var(--panel); border-bottom: 1px solid var(--border);
      padding: 12px 16px; display: flex; flex-wrap: wrap; gap: 10px;
      align-items: center; justify-content: space-between; position: sticky; top: 0; z-index: 1000;
    }
    .brand { display: flex; align-items: center; gap: 10px; }
    .badge-pro { background: var(--accent); color: #000; font-weight: 800; font-size: 11px; padding: 3px 7px; border-radius: 4px; }
    .brand h1 { font-size: 17px; font-weight: 700; letter-spacing: 0.3px; }
    .brand span { color: var(--accent); }
    .actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
    select.lang-selector {
      background: var(--panel-2); color: var(--text); border: 1px solid var(--border);
      padding: 5px; border-radius: 6px; font-size: 12px; cursor: pointer; font-weight: 600;
    }
    button {
      background: var(--panel-2); color: var(--text); border: 1px solid var(--border);
      padding: 7px 12px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;
    }
    button:hover { border-color: var(--accent); }
    button.primary { background: var(--accent); color: #000; border-color: var(--accent); }
    .kpis {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
      gap: 10px; padding: 12px 16px; background: #0e1420; border-bottom: 1px solid var(--border);
    }
    .kpi { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
    .kpi label { font-size: 11px; color: var(--muted); text-transform: uppercase; }
    .kpi .val { font-size: 19px; font-weight: 800; margin-top: 3px; color: var(--accent-2); }
    
    /* Nueva Barra de Búsqueda y Filtros de Categorías */
    .search-category-bar {
      padding: 10px 16px; background: var(--panel); border-bottom: 1px solid var(--border);
      display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    }
    .search-input-wrapper { flex: 1; min-width: 200px; position: relative; }
    .search-input-wrapper input {
      width: 100%; background: var(--bg); border: 1px solid var(--border); color: #fff;
      padding: 8px 12px 8px 32px; border-radius: 6px; font-size: 13px;
    }
    .search-input-wrapper i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--muted); }
    
    .category-filters { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
    .category-filters::-webkit-scrollbar { display: none; }
    .cat-btn {
      white-space: nowrap; border-radius: 20px; padding: 6px 14px; font-size: 12px;
      background: var(--panel-2); color: var(--text); border: 1px solid var(--border);
    }
    .cat-btn.active { background: var(--accent); color: #000; border-color: var(--accent); }

    .main-grid { display: grid; grid-template-columns: 1fr; flex: 1; }
    @media (min-width: 900px) { .main-grid { grid-template-columns: 1.4fr 1fr; } }
    #map { width: 100%; height: 420px; z-index: 1; }
    @media (min-width: 900px) { #map { height: calc(100vh - 235px); } }
    
    .sidebar { padding: 14px 16px; overflow-y: auto; max-height: calc(100vh - 235px); display: flex; flex-direction: column; gap: 12px; }
    
    /* Caja de Anuncios y Comercios */
    .sponsor-box {
      background: linear-gradient(135deg, #1e293b, #0f172a);
      border: 1px solid var(--accent); border-radius: 8px; padding: 12px; position: relative;
    }
    .sponsor-tag { font-size: 10px; color: var(--accent); font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; }
    .sponsor-box h3 { font-size: 14px; margin: 4px 0; }
    .sponsor-box p { font-size: 12px; color: var(--muted); line-height: 1.4; }
    
    .card-list { display: flex; flex-direction: column; gap: 10px; }
    .item-card {
      background: var(--panel); border: 1px solid var(--border); border-radius: 8px;
      padding: 12px; cursor: pointer; transition: 0.15s; position: relative;
    }
    .item-card:hover { border-color: var(--accent-2); }
    .item-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .item-head h4 { font-size: 14px; color: #fff; display: flex; align-items: center; gap: 6px; }
    .cat-badge { font-size: 9px; padding: 3px 8px; border-radius: 12px; font-weight: bold; text-transform: uppercase; }
    .cat-badge.epp { background: rgba(16,185,129,0.1); color: var(--success); border: 1px solid rgba(16,185,129,0.2); }
    .cat-badge.repuestos { background: rgba(56,189,248,0.1); color: var(--accent-2); border: 1px solid rgba(56,189,248,0.2); }
    .cat-badge.restaurante { background: rgba(245,158,11,0.1); color: var(--accent); border: 1px solid rgba(245,158,11,0.2); }
    .cat-badge.transporte { background: rgba(139,92,246,0.1); color: #a78bfa; border: 1px solid rgba(139,92,246,0.2); }
    .cat-badge.negocio { background: rgba(244,63,94,0.1); color: #f43f5e; border: 1px solid rgba(244,63,94,0.2); }
    
    .item-meta { font-size: 12px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 6px; }
    .item-desc { font-size: 11px; color: var(--text); background: var(--panel-2); padding: 5px 8px; border-radius: 5px; }
    .weather-widget { font-size: 11px; color: #38bdf8; display: flex; align-items: center; gap: 4px; margin-top: 4px; }
    
    /* Indicador de Pago/Membresía */
    .status-badge { font-size: 10px; font-weight: bold; padding: 2px 6px; border-radius: 4px; }
    .status-badge.active { background: var(--success); color: #000; }
    .status-badge.expired { background: var(--danger); color: #fff; }

    .modal-backdrop {
      display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.78);
      z-index: 2000; align-items: center; justify-content: center; padding: 16px;
    }
    .modal {
      background: var(--panel); border: 1px solid var(--border); border-radius: 10px;
      width: 100%; max-width: 480px; padding: 18px; max-height: 90vh; overflow-y: auto;
    }
    .modal h2 { font-size: 16px; margin-bottom: 10px; color: var(--accent); }
    .field { margin-bottom: 10px; }
    .field label { display: block; font-size: 11px; color: var(--muted); margin-bottom: 4px; }
    .field input, .field select, .field textarea {
      width: 100%; background: var(--bg); border: 1px solid var(--border);
      color: #fff; padding: 8px; border-radius: 6px; font-size: 13px;
    }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <h1>VenePetrol <span>Intel</span></h1>
      <span class="badge-pro">Directory & Clima</span>
    </div>
    <div class="actions">
      <select class="lang-selector" id="langSel" onchange="toggleLanguage(this.value)">
        <option value="es">🇪🇸 Español</option>
        <option value="en">🇺🇸 English</option>
      </select>
      <button onclick="exportCSV()"><i class="fa-solid fa-download"></i> <span data-i18n="export">Exportar CSV</span></button>
      <button onclick="openProModal()"><i class="fa-solid fa-star"></i> <span data-i18n="promote">Membresías / Vender</span></button>
      <button class="primary" onclick="openAdmin()"><i class="fa-solid fa-lock"></i> <span data-i18n="adminBtn">Admin</span></button>
    </div>
  </header>

  <section class="kpis">
    <div class="kpi"><label data-i18n="kpiNodes">Registros Activos</label><div class="val" id="kpi-nodes">35</div></div>
    <div class="kpi"><label data-i18n="kpiBpd">Prod. Est (BPD)</label><div class="val" id="kpi-bpd">0</div></div>
    <div class="kpi"><label data-i18n="kpiSub">Membresías Activas</label><div class="val" id="kpi-sub" style="color:#10b981;">0</div></div>
    <div class="kpi"><label data-i18n="kpiCategories">Categorías</label><div class="val" style="color:#f59e0b;">5 Categorías</div></div>
  </section>

  <!-- Filtros de Búsqueda Avanzados -->
  <div class="search-category-bar">
    <div class="search-input-wrapper">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" id="searchInput" placeholder="Buscar negocios, servicios, repuestos..." data-i18n-placeholder="searchPl" oninput="render()">
    </div>
    <div class="category-filters" id="catBar">
      <button class="cat-btn active" onclick="filterCategory('TODAS', this)" data-i18n="catAll">Todos (35)</button>
      <button class="cat-btn" onclick="filterCategory('petroleo', this)" data-i18n="catPet">Instalaciones Petroleras</button>
      <button class="cat-btn" onclick="filterCategory('repuestos', this)" data-i18n="catRep">Venta de Repuestos</button>
      <button class="cat-btn" onclick="filterCategory('restaurante', this)" data-i18n="catRest">Restaurantes</button>
      <button class="cat-btn" onclick="filterCategory('transporte', this)" data-i18n="catTrans">Empresas de Transporte</button>
      <button class="cat-btn" onclick="filterCategory('negocio', this)" data-i18n="catBiz">Otros Negocios</button>
    </div>
  </div>

  <main class="main-grid">
    <div id="map"></div>
    <aside class="sidebar">
      <!-- Banner para Anunciar tu Negocio -->
      <div class="sponsor-box">
        <div class="sponsor-tag" data-i18n="advTag">Espacio B2B · ¡Promociónate!</div>
        <h3 id="spTitle" data-i18n="spTitleDefault">Servicios Industriales & Logística Faja Oriente</h3>
        <p id="spDesc" data-i18n="spDescDefault">Ofrece tus servicios de transporte, repuestos o comida aquí. Promociona tu negocio en el mapa y gana visibilidad para todo el sector.</p>
        <div style="margin-top:8px; display:flex; gap:8px;">
          <button class="primary" onclick="openProModal()"><i class="fa-solid fa-circle-dollar-to-slot"></i> <span data-i18n="advBtn">Comprar Anuncio / Registrar Negocio</span></button>
        </div>
      </div>
      
      <div id="nodesList" class="card-list"></div>
    </aside>
  </main>

  <!-- PANEL DE ADMINISTRADOR AMPLIADO -->
  <div class="modal-backdrop" id="adminModal">
    <div class="modal">
      <h2 data-i18n="adminTitle">Panel Administrador - VenePetrol</h2>
      
      <!-- Edición del Sponsor Destacado -->
      <div class="field"><label data-i18n="admSpT">Título Anuncio Destacado (Español)</label><input id="inSpTitle" /></div>
      <div class="field"><label data-i18n="admSpT_en">Título Anuncio Destacado (Inglés)</label><input id="inSpTitle_en" /></div>
      <div class="field"><label data-i18n="admSpD">Descripción del Anuncio (Español)</label><textarea id="inSpDesc" rows="2"></textarea></div>
      <div class="field"><label data-i18n="admSpD_en">Descripción del Anuncio (Inglés)</label><textarea id="inSpDesc_en" rows="2"></textarea></div>
      
      <hr style="border-color:var(--border); margin:12px 0;" />
      <h3 style="font-size:14px; color:var(--accent-2); margin-bottom:8px;" data-i18n="admAddNew">Registrar o Modificar Negocio / Sitio</h3>
      
      <div class="field">
        <label data-i18n="admSelectEdit">Elegir un registro para editar (o crear nuevo)</label>
        <select id="selNode" onchange="loadNodeData(this.value)">
          <option value="new" data-i18n="admNewOption">[ + CREAR NUEVO REGISTRO ]</option>
        </select>
      </div>
      
      <div class="field-row">
        <div class="field"><label data-i18n="admName">Nombre (Español)</label><input id="inNodeName" /></div>
        <div class="field"><label data-i18n="admNameEn">Nombre (Inglés)</label><input id="inNodeNameEn" /></div>
      </div>

      <div class="field-row">
        <div class="field">
          <label data-i18n="admCategory">Categoría</label>
          <select id="inNodeCategory">
            <option value="petroleo">Petróleo / Operaciones</option>
            <option value="repuestos">Venta de Repuestos</option>
            <option value="restaurante">Restaurante / Comida</option>
            <option value="transporte">Empresa de Transporte</option>
            <option value="negocio">Otros Negocios</option>
          </select>
        </div>
        <div class="field"><label data-i18n="admBasin">Zona / Cuenca</label><input id="inNodeBasin" /></div>
      </div>

      <div class="field-row">
        <div class="field"><label>Latitude (Y)</label><input type="number" step="0.01" id="inNodeLat" /></div>
        <div class="field"><label>Longitude (X)</label><input type="number" step="0.01" id="inNodeLng" /></div>
      </div>

      <div class="field-row">
        <div class="field"><label data-i18n="admBpd">Producción (BPD) *Si aplica</label><input type="number" id="inNodeBpd" /></div>
        <div class="field">
          <label data-i18n="admStatus">Membresía / Pago</label>
          <select id="inNodeStatus">
            <option value="active">Activo (Pago del Mes)</option>
            <option value="expired">Expirado / Pendiente</option>
            <option value="free">Gratuito / No comercial</option>
          </select>
        </div>
      </div>

      <div class="field-row">
        <div class="field"><label data-i18n="admExpire">Fecha de Vencimiento</label><input type="date" id="inNodeExpire" /></div>
        <div class="field"><label data-i18n="admSpec">Contacto / Info Extra (Español)</label><input id="inNodeEpp" /></div>
      </div>
      <div class="field"><label data-i18n="admSpecEn">Contacto / Info Extra (Inglés)</label><input id="inNodeEppEn" /></div>

      <div style="display:flex; gap:8px; justify-content:space-between; margin-top:12px;">
        <button onclick="deleteNode()" id="btnDelete" style="border-color:var(--danger); color:var(--danger); display:none;"><i class="fa-solid fa-trash"></i> Eliminar</button>
        <div style="display:flex; gap:8px; margin-left:auto;">
          <button onclick="closeModals()" data-i18n="close">Cerrar</button>
          <button class="primary" onclick="saveAdmin()"><i class="fa-solid fa-floppy-disk"></i> <span data-i18n="save">Guardar Cambios</span></button>
        </div>
      </div>
    </div>
  </div>

  <!-- MEMBRESÍAS Y VENTAS -->
  <div class="modal-backdrop" id="proModal">
    <div class="modal">
      <h2 data-i18n="salesTitle">Promociona tu Empresa o Negocio</h2>
      <p style="font-size:13px; color:var(--muted); line-height:1.5; margin-bottom:12px;" data-i18n="salesIntro">
        Haz que miles de trabajadores, contratistas y transportistas del sector petrolero te encuentren. Anuncia tu negocio o servicios en el mapa en vivo y recibe clientes por WhatsApp de inmediato.
      </p>
      
      <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:12px;">
        <div class="kpi" style="border-color: var(--accent);">
          <label data-i18n="plan1Title">🌟 Banner Destacado Superior</label>
          <p style="font-size:12px; margin-top:4px;" data-i18n="plan1Desc">Aparece en el banner de arriba en toda la plataforma. Ideal para grandes talleres de repuestos, proveedores industriales y transporte de maquinaria.</p>
          <div style="font-size:13px; font-weight:800; color:var(--accent); margin-top:4px;">$90 USD / Mes</div>
        </div>

        <div class="kpi" style="border-color: var(--accent-2);">
          <label data-i18n="plan2Title">📍 Clasificado / Punto en el Mapa</label>
          <p style="font-size:12px; margin-top:4px;" data-i18n="plan2Desc">Inscribe tu restaurante, ferretería, hotel o empresa de logística directo en tu zona de operaciones para que todos sepan cómo encontrarte.</p>
          <div style="font-size:13px; font-weight:800; color:var(--accent-2); margin-top:4px;">$25 USD / Mes</div>
        </div>
      </div>
      
      <div style="display:flex; gap:8px; justify-content:flex-end;">
        <button onclick="closeModals()" data-i18n="close">Cerrar</button>
        <button class="primary" onclick="window.open('https://wa.me/?text=Hola%20Nery,%20me%20gustaria%20anunciar%20mi%20negocio%20en%20VenePetrol%20Intel','_blank')">
          <i class="fa-brands fa-whatsapp"></i> <span data-i18n="salesContact">Contactar por WhatsApp</span>
        </button>
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script>
    // Diccionario para doble idioma
    const i18n = {
      es: {
        export: "Exportar CSV", promote: "Membresías / Vender", adminBtn: "Admin",
        kpiNodes: "Registros Activos", kpiBpd: "Prod. Est (BPD)", kpiSub: "Membresías Activas", kpiCategories: "Categorías",
        searchPl: "Buscar negocios, servicios, repuestos...",
        catAll: "Todos", catPet: "Petrolero", catRep: "Repuestos", catRest: "Restaurantes", catTrans: "Transporte", catBiz: "Negocios",
        advTag: "Espacio B2B · ¡Promociónate!",
        spTitleDefault: "Servicios Industriales & Logística Faja Oriente",
        spDescDefault: "Ofrece tus servicios de transporte, repuestos o comida aquí. Promociona tu negocio en el mapa y gana visibilidad para todo el sector.",
        advBtn: "Comprar Anuncio / Registrar Negocio",
        adminTitle: "Panel Administrador - VenePetrol",
        admSpT: "Título Anuncio Destacado (Español)", admSpT_en: "Título Anuncio Destacado (Inglés)",
        admSpD: "Descripción del Anuncio (Español)", admSpD_en: "Descripción del Anuncio (Inglés)",
        admAddNew: "Registrar o Modificar Negocio / Sitio",
        admSelectEdit: "Elegir un registro para editar (o crear nuevo)",
        admNewOption: "[ + CREAR NUEVO REGISTRO ]",
        admName: "Nombre (Español)", admNameEn: "Nombre (Inglés)",
        admCategory: "Categoría", admBasin: "Zona / Cuenca",
        admBpd: "Producción (BPD) *Si aplica", admStatus: "Membresía / Pago",
        admExpire: "Fecha de Vencimiento", admSpec: "Contacto / Info Extra (Español)", admSpecEn: "Contacto / Info Extra (Inglés)",
        close: "Cerrar", save: "Guardar Cambios", delete: "Eliminar",
        salesTitle: "Promociona tu Empresa o Negocio",
        salesIntro: "Haz que miles de trabajadores, contratistas y transportistas del sector petrolero te encuentren. Anuncia tu negocio o servicios en el mapa en vivo y recibe clientes por WhatsApp de inmediato.",
        plan1Title: "🌟 Banner Destacado Superior",
        plan1Desc: "Aparece en el banner de arriba en toda la plataforma. Ideal para grandes talleres de repuestos, proveedores industriales y transporte de maquinaria.",
        plan2Title: "📍 Clasificado / Punto en el Mapa",
        plan2Desc: "Inscribe tu restaurante, ferretería, hotel o empresa de logística directo en tu zona de operaciones para que todos sepan cómo encontrarte.",
        salesContact: "Contactar por WhatsApp",
        demand: "Demanda", active: "Membresía Activa", expired: "Expirado / Impago", free: "Gratuito",
        petroleo: "Operaciones", repuestos: "Venta de Repuestos", restaurante: "Restaurante", transporte: "Transporte", negocio: "Otros Negocios",
        contact: "Contacto", zone: "Zona", production: "Producción", expiredAlert: "¡Atención: Impago!", expireDate: "Vence el"
      },
      en: {
        export: "Export CSV", promote: "Subscriptions / Sales", adminBtn: "Admin",
        kpiNodes: "Active Records", kpiBpd: "Est. Prod. (BPD)", kpiSub: "Active Memberships", kpiCategories: "Categories",
        searchPl: "Search businesses, services, spare parts...",
        catAll: "All", catPet: "Oil Sites", catRep: "Spare Parts", catRest: "Restaurants", catTrans: "Logistics", catBiz: "Other Businesses",
        advTag: "B2B ADVERTISING SPACE",
        spTitleDefault: "Faja Oriente Industrial Services & Logistics",
        spDescDefault: "Offer your transport, spare parts or food services here. Promote your business on the map and gain visibility for the entire sector.",
        advBtn: "Buy Ad / Register Business",
        adminTitle: "Admin Panel - VenePetrol",
        admSpT: "Featured Ad Title (Spanish)", admSpT_en: "Featured Ad Title (English)",
        admSpD: "Featured Ad Desc (Spanish)", admSpD_en: "Featured Ad Desc (English)",
        admAddNew: "Register or Modify Business / Site",
        admSelectEdit: "Select a record to edit (or create new)",
        admNewOption: "[ + CREATE NEW RECORD ]",
        admName: "Name (Spanish)", admNameEn: "Name (English)",
        admCategory: "Category", admBasin: "Zone / Basin",
        admBpd: "Production (BPD) *If applicable", admStatus: "Membership / Payment",
        admExpire: "Expiration Date", admSpec: "Contact / Extra Info (Spanish)", admSpecEn: "Contact / Extra Info (English)",
        close: "Close", save: "Save Changes", delete: "Delete",
        salesTitle: "Promote Your Business or Company",
        salesIntro: "Let thousands of oil workers, contractors and logistics companies find you. List your restaurant, store, or transport fleet on our map.",
        plan1Title: "🌟 Top Featured Banner",
        plan1Desc: "Visible at the top for all platform visitors. Ideal for large stores, industrial providers, and heavy transport services.",
        plan2Title: "📍 Classified / Map Point",
        plan2Desc: "List your restaurant, hotel, hardware store or fleet right on the map where operators are looking.",
        salesContact: "Contact via WhatsApp",
        demand: "Needs", active: "Paid", expired: "Unpaid / Expired", free: "Free",
        petroleo: "Petroleum", repuestos: "Spare Parts", restaurante: "Food & Dining", transporte: "Logistics / Transport", negocio: "Other",
        contact: "Contact", zone: "Zone", production: "Production", expiredAlert: "Payment Expired!", expireDate: "Expires"
      }
    };

    let currentLanguage = localStorage.getItem('vp_lang') || 'es';

    const defaultNodes = [
      { id: 1, name: "Nodo Cerro Negro (Morichal)", name_en: "Cerro Negro Node (Morichal)", category: "petroleo", basin: "Faja del Orinoco", lat: 8.52, lng: -63.35, bpd: 115000, epp: "Bragas ignífugas, botas puntera composite", epp_en: "FR Coveralls, composite safety boots", status: "free" },
      { id: 2, name: "Nodo Zuata / San Diego de Cabrutica", name_en: "Zuata Node (San Diego)", category: "petroleo", basin: "Faja del Orinoco", lat: 8.35, lng: -64.72, bpd: 130000, epp: "Botas caña alta petroleras, lentes UV", epp_en: "Oil worker boots, UV safety glasses", status: "free" },
      { id: 35, name: "Repuestos El Tigre 4x4", name_en: "El Tigre 4x4 Spare Parts", category: "repuestos", basin: "Faja del Orinoco", lat: 8.88, lng: -64.24, bpd: 0, epp: "Telf: +584240000000. Respuestas mecánicos y rodamientos.", epp_en: "Phone: +584240000000. Bearings and parts.", status: "active", expire: "2027-04-15" },
      { id: 36, name: "Transporte y Grúas Anaco C.A.", name_en: "Anaco Transport & Cranes Co.", category: "transporte", basin: "Monagas / Anaco", lat: 9.43, lng: -64.46, bpd: 0, epp: "Telf: +584120000000. Grúas telescópicas, camiones cama baja.", epp_en: "Tel: +584120000000. Cranes, flatbeds, heavy haul.", status: "active", expire: "2027-02-28" },
      { id: 37, name: "Restaurante El Gran Caney del Petróleo", name_en: "Gran Caney del Petroleo Restaurant", category: "restaurante", basin: "Faja del Orinoco", lat: 8.60, lng: -63.30, bpd: 0, epp: "Atención a cuadrillas, desayunos, almuerzos. Telf: 0283-00000", epp_en: "Daily meals, catering for crews. Tel: 0283-00000", status: "expired", expire: "2026-11-20" }
    ];

    let nodes = JSON.parse(localStorage.getItem('vp_nodes')) || defaultNodes;
    let currentCategory = 'TODAS';

    const map = L.map('map').setView([8.8, -66.0], 6);
    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      attribution: 'Esri Satellite · VenePetrol Intel'
    }).addTo(map);
    let markersLayer = L.layerGroup().addTo(map);

    function toggleLanguage(lang) {
      currentLanguage = lang;
      localStorage.setItem('vp_lang', lang);
      document.getElementById('langSel').value = lang;
      
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (i18n[lang][key]) el.innerText = i18n[lang][key];
      });

      document.querySelectorAll('[data-i18n-placeholder]').forEach(el => {
        const key = el.getAttribute('data-i18n-placeholder');
        if (i18n[lang][key]) el.placeholder = i18n[lang][key];
      });

      const sp = JSON.parse(localStorage.getItem('vp_sponsor'));
      document.getElementById('spTitle').innerText = sp ? (lang === 'es' ? sp.title : sp.title_en) : i18n[lang].spTitleDefault;
      document.getElementById('spDesc').innerText = sp ? (lang === 'es' ? sp.desc : sp.desc_en) : i18n[lang].spDescDefault;

      render();
    }

    async function fetchWeather(lat, lng) {
      try {
        const res = await fetch(`https://api.open-meteo.com/v1/forecast?latitude=${lat}&longitude=${lng}&current_weather=true`);
        const data = await res.json();
        if (data.current_weather) {
          return `${data.current_weather.temperature}°C, ${data.current_weather.windspeed} km/h`;
        }
      } catch (e) { return null; }
    }

    async function render() {
      markersLayer.clearLayers();
      const list = document.getElementById('nodesList');
      list.innerHTML = '';
      
      const searchWord = document.getElementById('searchInput').value.toLowerCase();
      let totalBpd = 0;
      let activeSubs = 0;

      // Actualizar conteos de botones de categoría
      document.getElementById('catBar').children[0].innerText = `${i18n[currentLanguage].catAll} (${nodes.length})`;

      const filtered = nodes.filter(n => {
        const nameText = currentLanguage === 'es' ? n.name : (n.name_en || n.name);
        const matchCat = currentCategory === 'TODAS' || n.category === currentCategory;
        const matchSearch = nameText.toLowerCase().includes(searchWord) || 
                            n.basin.toLowerCase().includes(searchWord) || 
                            (n.epp && n.epp.toLowerCase().includes(searchWord));
        return matchCat && matchSearch;
      });

      for (let n of filtered) {
        totalBpd += Number(n.bpd || 0);
        if (n.status === 'active') activeSubs++;

        const isPet = n.category === 'petroleo';
        const color = isPet ? '#f59e0b' : (n.status === 'expired' ? '#ef4444' : '#38bdf8');
        
        const marker = L.circleMarker([n.lat, n.lng], {
          radius: isPet ? 8 : 6, fillColor: color, color: '#fff', weight: 1.5, fillOpacity: 0.9
        });

        marker.addTo(markersLayer);
        
        let weatherInfo = "Cargando clima / Loading weather...";
        marker.on('click', async () => {
          map.setView([n.lat, n.lng], 9);
          const weather = await fetchWeather(n.lat, n.lng);
          weatherInfo = weather ? `🌤️ ${weather}` : "🌤️ Sin datos de clima / No weather data";
          
          const popupContent = `
            <b>${currentLanguage === 'es' ? n.name : (n.name_en || n.name)}</b><br/>
            ${i18n[currentLanguage].zone}: ${n.basin}<br/>
            ${n.bpd > 0 ? `${i18n[currentLanguage].production}: ${Number(n.bpd).toLocaleString()} BPD<br/>` : ''}
            ${n.epp ? `ℹ️ ${n.epp}<br/>` : ''}
            <b>${weatherInfo}</b>
          `;
          marker.bindPopup(popupContent).openPopup();
        });

        const card = document.createElement('div');
        card.className = 'item-card';
        
        const badgeClass = n.category;
        const badgeLabel = i18n[currentLanguage][n.category];
        
        const nameToShow = currentLanguage === 'es' ? n.name : (n.name_en || n.name);
        const descToShow = currentLanguage === 'es' ? n.epp : (n.epp_en || n.epp);

        let statusHtml = '';
        if (n.status === 'active') statusHtml = `<span class="status-badge active"><i class="fa-solid fa-check"></i> ${i18n[currentLanguage].active}</span>`;
        if (n.status === 'expired') statusHtml = `<span class="status-badge expired"><i class="fa-solid fa-triangle-exclamation"></i> ${i18n[currentLanguage].expired}</span>`;

        card.innerHTML = `
          <div class="item-head">
            <h4>${nameToShow}</h4>
            <span class="cat-badge ${badgeClass}">${badgeLabel}</span>
          </div>
          <div class="item-meta">
            <span>📍 ${n.basin}</span>
            ${n.bpd > 0 ? `<span>🛢️ ${Number(n.bpd).toLocaleString()} BPD</span>` : ''}
            ${statusHtml}
            ${n.expire ? `<span style="font-size:11px; color:var(--muted)">📅 ${i18n[currentLanguage].expireDate} ${n.expire}</span>` : ''}
          </div>
          <div class="item-desc">${descToShow}</div>
        `;

        card.onclick = () => { map.setView([n.lat, n.lng], 10); marker.fire('click'); };
        list.appendChild(card);
      }

      document.getElementById('kpi-nodes').innerText = filtered.length;
      document.getElementById('kpi-bpd').innerText = totalBpd.toLocaleString();
      document.getElementById('kpi-sub').innerText = activeSubs;
    }

    function filterCategory(cat, btn) {
      currentCategory = cat;
      document.querySelectorAll('.cat-btn').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      render();
    }

    function openAdmin() {
      const pass = prompt("Clave de Administrador / Admin Password:");
      if (pass !== "ADMIN2026") return alert("Clave incorrecta");
      
      const sp = JSON.parse(localStorage.getItem('vp_sponsor')) || { title: i18n.es.spTitleDefault, title_en: i18n.en.spTitleDefault, desc: i18n.es.spDescDefault, desc_en: i18n.en.spDescDefault };
      document.getElementById('inSpTitle').value = sp.title;
      document.getElementById('inSpTitle_en').value = sp.title_en || sp.title;
      document.getElementById('inSpDesc').value = sp.desc;
      document.getElementById('inSpDesc_en').value = sp.desc_en || sp.desc;

      const sel = document.getElementById('selNode');
      sel.innerHTML = `<option value="new">[ + CREAR NUEVO REGISTRO ]</option>` + 
        nodes.map(n => `<option value="${n.id}">${n.name} [${n.category}]</option>`).join('');

      loadNodeData('new');
      document.getElementById('adminModal').style.display = 'flex';
    }

    function loadNodeData(val) {
      const isNew = val === 'new';
      document.getElementById('btnDelete').style.display = isNew ? 'none' : 'block';
      
      if (isNew) {
        document.getElementById('inNodeName').value = '';
        document.getElementById('inNodeNameEn').value = '';
        document.getElementById('inNodeCategory').value = 'petroleo';
        document.getElementById('inNodeBasin').value = '';
        document.getElementById('inNodeLat').value = 8.8;
        document.getElementById('inNodeLng').value = -64.2;
        document.getElementById('inNodeBpd').value = 0;
        document.getElementById('inNodeStatus').value = 'free';
        document.getElementById('inNodeExpire').value = '';
        document.getElementById('inNodeEpp').value = '';
        document.getElementById('inNodeEppEn').value = '';
      } else {
        const f = nodes.find(x => x.id == val);
        if (f) {
          document.getElementById('inNodeName').value = f.name;
          document.getElementById('inNodeNameEn').value = f.name_en || f.name;
          document.getElementById('inNodeCategory').value = f.category;
          document.getElementById('inNodeBasin').value = f.basin;
          document.getElementById('inNodeLat').value = f.lat;
          document.getElementById('inNodeLng').value = f.lng;
          document.getElementById('inNodeBpd').value = f.bpd || 0;
          document.getElementById('inNodeStatus').value = f.status || 'free';
          document.getElementById('inNodeExpire').value = f.expire || '';
          document.getElementById('inNodeEpp').value = f.epp || '';
          document.getElementById('inNodeEppEn').value = f.epp_en || '';
        }
      }
    }

    function saveAdmin() {
      const sp = {
        title: document.getElementById('inSpTitle').value,
        title_en: document.getElementById('inSpTitle_en').value,
        desc: document.getElementById('inSpDesc').value,
        desc_en: document.getElementById('inSpDesc_en').value
      };
      localStorage.setItem('vp_sponsor', JSON.stringify(sp));

      const selVal = document.getElementById('selNode').value;
      const data = {
        name: document.getElementById('inNodeName').value,
        name_en: document.getElementById('inNodeNameEn').value,
        category: document.getElementById('inNodeCategory').value,
        basin: document.getElementById('inNodeBasin').value,
        lat: Number(document.getElementById('inNodeLat').value),
        lng: Number(document.getElementById('inNodeLng').value),
        bpd: Number(document.getElementById('inNodeBpd').value) || 0,
        status: document.getElementById('inNodeStatus').value,
        expire: document.getElementById('inNodeExpire').value,
        epp: document.getElementById('inNodeEpp').value,
        epp_en: document.getElementById('inNodeEppEn').value
      };

      if (selVal === 'new') {
        data.id = Date.now();
        nodes.push(data);
      } else {
        const idx = nodes.findIndex(x => x.id == selVal);
        if (idx > -1) {
          data.id = Number(selVal);
          nodes[idx] = data;
        }
      }

      localStorage.setItem('vp_nodes', JSON.stringify(nodes));
      toggleLanguage(currentLanguage);
      closeModals();
    }

    function deleteNode() {
      const val = document.getElementById('selNode').value;
      if (val !== 'new' && confirm("¿Eliminar este registro?")) {
        nodes = nodes.filter(x => x.id != val);
        localStorage.setItem('vp_nodes', JSON.stringify(nodes));
        toggleLanguage(currentLanguage);
        closeModals();
      }
    }

    function exportCSV() {
      let csv = "ID,Category,Name,Name_EN,Zone_Basin,Latitude,Longitude,Est_Production_BPD,Membership_Status,Expiration_Date,Extra_Info\n";
      nodes.forEach(n => { 
        csv += `${n.id},"${n.category}","${n.name}","${n.name_en || ''}","${n.basin}",${n.lat},${n.lng},${n.bpd || 0},"${n.status || 'free'}","${n.expire || ''}","${n.epp || ''}"\n`; 
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'venepetrol_leads_directory.csv';
      a.click();
    }

    function openProModal() { document.getElementById('proModal').style.display = 'flex'; }
    function closeModals() { document.querySelectorAll('.modal-backdrop').forEach(m => m.style.display = 'none'); }

    // Inicializar
    toggleLanguage(currentLanguage);
  </script>
</body>
</html>
